    "@reduxjs/toolkit": "2.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "postcss": "8.5.25",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
